{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>c-gerke/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Trivy CLI pinned as the security-scan reusable workflow's default (shared by release.yml and pr-ci.yml)",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-scan\\.ya?ml$/"
      ],
      "matchStrings": [
        "default:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy"
    },
    {
      "customType": "regex",
      "description": "Go builder image pinned for the lancache-dns dnstool stage",
      "managerFilePatterns": [
        "/^scripts\\/pin-dns-go-builder\\.sh$/"
      ],
      "matchStrings": [
        "(?:^|\\n)DNS_GO_BUILDER_IMAGE=\"(?<depName>golang):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Images built from this repo — do not pin digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/oct8l\\/lancache/"
      ],
      "pinDigests": false
    }
  ]
}
