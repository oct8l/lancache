{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>c-gerke/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Trivy CLI pinned as the security-scan reusable workflow's default (shared by release.yml and pr-ci.yml)",
      "managerFilePatterns": [
        "/^\\.github/workflows/security-scan\\.ya?ml$/"
      ],
      "matchStrings": [
        "default:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy"
    },
    {
      "customType": "regex",
      "description": "Go builder image pinned for lancache-dns's dnstool build stage (upstream pins an old golang:1.23.1-alpine with unpatched stdlib CVEs)",
      "managerFilePatterns": [
        "/^\\.github/workflows/build-candidates\\.ya?ml$/"
      ],
      "matchStrings": [
        "DNS_GO_BUILDER_IMAGE:\\s*(?<depName>golang):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Images built from this repo — do not pin digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/oct8l\\/lancache/"
      ],
      "pinDigests": false
    }
  ]
}
