{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>c-gerke/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Trivy CLI pinned in the release workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.ya?ml$/"
      ],
      "matchStrings": [
        "TRIVY_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "aquasecurity/trivy"
    }
  ],
  "packageRules": [
    {
      "description": "Images built from this repo — do not pin digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^ghcr\\.io\\/oct8l\\/lancache/"
      ],
      "pinDigests": false
    }
  ]
}
